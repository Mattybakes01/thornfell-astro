---
// Homepage hero.
// - The full Thornfell emblem is the centrepiece.
// - On a visitor's first page view of the session the entrance plays
//   slowly (html.intro-full, set in BaseLayout); after that it's quick.
// - Background photo is processed by Astro and handed to CSS as a
//   custom property, so the URL is always right in the built site.
import { Image, getImage } from 'astro:assets';
import heroPhoto from '../img/header-img.jpg';
import logo from '../img/logo.jpg';
import logoCutout from '../img/logo-cutout.png';

const hero = await getImage({ src: heroPhoto, width: 1920, format: 'webp' });
// Cut-out of the logo (transparent background, metal only). The CSS uses
// it as a mask so the sheen only ever lands on the metal.
const logoMask = await getImage({ src: logoCutout, width: 600, format: 'webp', quality: 60 });

// Embers: a handful of sparks with fixed "random" positions and timings.
// A tiny seeded generator means the same values on every build.
let seed = 7;
const rand = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const embers = Array.from({ length: 18 }, () => ({
    left: (rand() * 100).toFixed(1),
    size: (2 + rand() * 3).toFixed(1),
    duration: (7 + rand() * 7).toFixed(1),
    delay: (rand() * 8).toFixed(1),
    drift: ((rand() - 0.5) * 120).toFixed(0),
}));
---
<header class="hero" style={`--hero-image: url(${hero.src})`}>
    <div class="hero__backdrop" aria-hidden="true"></div>

    <div class="hero__embers" aria-hidden="true">
        {embers.map((e) => (
            <span style={`--left:${e.left}%; --size:${e.size}px; --duration:${e.duration}s; --delay:${e.delay}s; --drift:${e.drift}px`}></span>
        ))}
    </div>

    <div class="hero__content">
        <h1 class="hero__logo" style={`--logo-mask: url(${logoMask.src})`}>
            <Image src={logo} alt="Thornfell" widths={[480, 800, 1200]} sizes="(min-width: 700px) 30rem, 80vw" loading="eager" fetchpriority="high" />
        </h1>

        <p class="hero__tagline light-italic-serif-text">Each hat forged by hand. Each thorn pressed in iron. A quiet signature, carried in shadow.</p>

        <div class="hero__actions">
            <a class="button button--glint" href="/collection">View the collection <span aria-hidden="true">&rarr;</span></a>
            <a class="text-link" href="/about">Our story</a>
        </div>
    </div>

    <a class="hero__scroll" href="#collection">
        <span>Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
</header>

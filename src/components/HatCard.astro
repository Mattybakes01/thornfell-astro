---
// One hat in a grid or carousel. The whole card links to the hat's own page.
import {Image} from 'astro:assets';
import { hatImage } from '../lib/hats.js';

const { hat } = Astro.props;
---

<a class="hat-card" href={`/collection/${hat.slug}`}>
    <div class="hat-card__frame">
        <Image src={hatImage(hat.images[0])} alt={hat.name} class="hat-card__image" widths={[400, 800]} sizes="(min-width: 720px) 20rem, 90vw" />
        <span class="hat-card__number">No. {hat.number}</span>
    </div>
    <h3 class="hat-card__title">{hat.name}</h3>
    <p class="hat-card__short">{hat.short}</p>
    <span class="hat-card__view">View <span aria-hidden="true">&rarr;</span></span>
</a>

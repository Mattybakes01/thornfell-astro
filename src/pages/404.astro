---
import Divider from "../components/Divider.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout noindex title="Page not found – Thornfell" description="This page could not be found.">
    <section class="page-intro page-intro--full">
        <p class="eyebrow">404</p>
        <h1 class="page-title">Lost the Trail</h1>
        <Divider />
        <p class="light-italic-serif-text">The page you were looking for isn't here.</p>
        <div class="hero__actions">
            <a class="button" href="/collection">View the collection</a>
            <a class="text-link" href="/">Home</a>
        </div>
    </section>
</BaseLayout>

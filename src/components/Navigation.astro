---
import {Image} from 'astro:assets';
import navLogo from '../img/logo.jpg';
---

<nav class="site-nav" aria-label="Main">
    <a class="site-nav__brand" href="/">
        <Image src={navLogo} alt="" class="site-nav__logo" width={80} />
        <span>Thornfell</span>
    </a>

    <!-- Menu button: only shown on small screens (see CSS). app.js toggles .is-open -->
    <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav-links">
        <span class="visually-hidden">Menu</span>
        <span class="site-nav__bars" aria-hidden="true"></span>
    </button>

    <ul class="site-nav__links" id="site-nav-links">
        <li><a href="/collection">Collection</a></li>
        <li><a href="/about">About</a></li>
        <li><a class="site-nav__cta" href="/contact">Contact</a></li>
    </ul>
</nav>

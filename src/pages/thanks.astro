---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
---

<BaseLayout noindex title="Thank you – Thornfell" description="Your enquiry has been sent.">
    <section class="page-intro page-intro--full">
        <p class="eyebrow">Enquiry received</p>
        <h1 class="page-title">Thank You</h1>
        <div class="divider" aria-hidden="true"><span>+</span></div>
        <p class="light-italic-serif-text">Your message is with us. {site.responseTime}</p>
        <div class="hero__actions">
            <a class="button" href="/collection">Back to the collection</a>
            <a class="text-link" href="/">Home</a>
        </div>
    </section>
</BaseLayout>

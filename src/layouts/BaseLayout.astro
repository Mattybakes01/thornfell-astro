---
import "../styles/global.css";
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import defaultShareImage from '../img/header-img.jpg';

// Each page can pass its own title, description, share image and
// structured data (JSON-LD) for search engines.
const {
  title = 'Thornfell – Handcrafted Headwear',
  description = 'Handcrafted hats, made one at a time in Britain.',
  image = defaultShareImage,
  jsonLd,
  noindex = false,
} = Astro.props;

// Share images need a full URL (https://thornfell.co.uk/_astro/...).
// getImage makes a 1200px-wide JPEG, the size Facebook/WhatsApp like.
const shareImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const shareImageUrl = new URL(shareImage.src, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<!-- Tells the CSS JavaScript is running (used by the divider animation) -->
		<script is:inline>document.documentElement.classList.add('js')</script>
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}

		<!-- Social share previews (WhatsApp, Facebook, X, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Thornfell" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={shareImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap.xml" />

		<!-- Preload the two fonts used above the fold so text doesn't flash -->
		<link rel="preload" href="/fonts/cinzel-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/cormorant-garamond-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<script>import '../js/app.js';</script>
	</head>
	<body>
		<Navigation />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

---
import Divider from "../components/Divider.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HatCard from "../components/HatCard.astro";
import { hats } from "../lib/hats.js";
import site from "../data/site.json";

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Thornfell',
    url: 'https://thornfell.co.uk',
    description: 'Handcrafted hats, made one at a time in Britain.',
    email: site.email,
    sameAs: [site.instagram],   // tells Google this Instagram account is ours
};
---

<BaseLayout jsonLd={jsonLd}>
    <Header />

    <section class="about fade-in">
        <p class="eyebrow">About</p>
        <p class="pull-quote">Crafted without compromise.<br><em>Worn without conformity.</em></p>
        <Divider />
        <p>Thornfell was born from a simple belief: A hat shouldn’t just be worn. It should say something about the person wearing it.</p>
        <p>Every Thornfell hat is individually handcrafted in Britain using traditional hat-making techniques, premium fur felts and carefully selected materials. No two are made quite the same.</p>
        <div class="section-action section-action--tight">
            <a class="text-link" href="/about">Read our story &rarr;</a>
        </div>
    </section>

    <section class="collection fade-in">
        <p class="eyebrow">Made one at a time</p>
        <h2>The Collection</h2>

        <!-- Carousel: the track scrolls sideways with CSS scroll-snap.
             The buttons just scroll it by one card (see app.js). -->
        <div class="carousel">
            <button class="carousel__button carousel__button--prev" type="button" aria-label="Previous hats">&lsaquo;</button>
            <ul class="carousel__track">
                {hats.map((hat) => (
                    <li class="carousel__slide"><HatCard hat={hat} /></li>
                ))}
            </ul>
            <button class="carousel__button carousel__button--next" type="button" aria-label="Next hats">&rsaquo;</button>
        </div>

        <div class="section-action">
            <a class="button" href="/collection">View full collection</a>
        </div>
    </section>

    <section class="commission fade-in">
        <p class="eyebrow">Enquiries</p>
        <h2>Commission a hat</h2>
        <p class="light-italic-serif-text">Every hat is made to order. Tell us what you have in mind and we'll get back to you within a few days.</p>
        <div class="section-action section-action--tight">
            <a class="button" href="/contact">Get in touch</a>
        </div>
    </section>
</BaseLayout>
